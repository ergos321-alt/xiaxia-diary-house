# Copy to .env for local development. Never commit the real file.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres
WEB_PASSWORD=replace-with-a-long-private-password
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
DIARY_API_TOKEN=replace-with-at-least-32-random-characters
APP_TIMEZONE=Asia/Shanghai
SESSION_COOKIE_SECURE=false

